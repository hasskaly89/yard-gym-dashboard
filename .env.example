SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=owner@theyardgym.com.au

# Meta Ads (Facebook/Instagram) — long-lived access token with ads_read on the account.
# Without these the Meta Ads page shows your real numbers as "Sample Data".
META_ACCESS_TOKEN=your-long-lived-system-user-token
META_AD_ACCOUNT_ID=741182451528211
META_AD_ACCOUNT_NAME=The Yard Gym Edensor Park

# Retention AI summaries — generates the "why + suggested action" call notes for
# at-risk members. Without a key, health scores still work; members just get no
# AI summary. Model defaults to Haiku 4.5 (cheap); override for higher quality.
ANTHROPIC_API_KEY=
# RETENTION_AI_MODEL=claude-haiku-4-5-20251001

# Access control
# ADMIN_EMAILS = who may log in at all (comma list; supports *@domain).
# SUPER_ADMIN_EMAILS = owner(s), always admin, cannot be locked out.
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=

# Scheduled routes (/api/milestones/cron, /api/cron/eod-summary) and manual
# syncs. Vercel sends `Authorization: Bearer $CRON_SECRET` on cron invocations
# only when CRON_SECRET is set in the project. SYNC_SECRET is accepted as well
# for a hand-triggered run. Neither the x-vercel-cron header nor a missing
# secret is treated as authenticated.
CRON_SECRET=
SYNC_SECRET=

# Mindbody webhook (/api/mindbody/webhooks). Prefer the subscription's
# messageSignatureKey (returned once by POST /subscriptions) so the existing
# X-Mindbody-Signature header keeps verifying with no URL change.
# Otherwise set MINDBODY_WEBHOOK_SECRET and add ?token=$MINDBODY_WEBHOOK_SECRET
# to the subscription URL. A bearer token of CRON_SECRET or SYNC_SECRET also
# works, but keep the webhook secret separate from the cron secret.
MINDBODY_WEBHOOK_SIGNATURE_KEY=
MINDBODY_WEBHOOK_SECRET=

# Dashboard AI agent — reads these inboxes via IMAP (Gmail App Passwords, same
# kind as SMTP_PASS). Leave blank to show a "connect inbox" state.
GMAIL_PERSONAL_USER=
GMAIL_PERSONAL_APP_PASSWORD=
GMAIL_BUSINESS_USER=
GMAIL_BUSINESS_APP_PASSWORD=
# Model for the daily brief (defaults to claude-sonnet-5)
# DASHBOARD_AI_MODEL=claude-sonnet-5
